# Generate a fresh value; do not reuse any previously committed secret.
# Example: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-new-random-secret-at-least-32-characters-long
APP_BASE_URL=http://localhost:3000

# Copy these values from your own Auth0 Application.
AUTH0_CLIENT_ID=your-auth0-application-client-id
AUTH0_CLIENT_SECRET=your-new-auth0-application-client-secret
AUTH0_AUDIENCE=https://api.conduit.local

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
