# Snowbridge local development only. Never commit real secrets.
SNOWBRIDGE_ENV=development
# Set this to the DSN for your native/local PostgreSQL instance.
# Example: postgresql://snowbridge:YOUR_PASSWORD@localhost:5432/snowbridge_metadata
SNOWBRIDGE_METADATA_DATABASE_URL=
SNOWBRIDGE_SECRET_PROVIDER=local
SNOWBRIDGE_LOG_LEVEL=INFO
SNOWBRIDGE_CONNECT_TIMEOUT_SECONDS=10
SNOWBRIDGE_STATEMENT_TIMEOUT_MS=0
