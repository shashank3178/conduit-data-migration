# Local development only. Never commit backend/.env or real credentials.
SNOWBRIDGE_ENV=development
# Replace the password with the password you set for the local snowbridge role.
SNOWBRIDGE_METADATA_DATABASE_URL=postgresql://snowbridge:CHANGE_ME@localhost:5432/snowbridge_metadata
SNOWBRIDGE_SECRET_PROVIDER=local
SNOWBRIDGE_LOG_LEVEL=INFO
SNOWBRIDGE_CONNECT_TIMEOUT_SECONDS=10
SNOWBRIDGE_STATEMENT_TIMEOUT_MS=0
