APP_NAME=Conduit
ENVIRONMENT=development

# The Compose service creates this database on its first initialization.
DATABASE_URL=postgresql+psycopg://conduit:conduit@localhost:5433/conduit_metadata

AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_AUDIENCE=https://api.conduit.local
AUTH0_ISSUER=https://your-tenant.region.auth0.com/

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key secret and stable. Losing it makes saved passwords unrecoverable.
CONNECTION_ENCRYPTION_KEY=replace-with-generated-fernet-key

CORS_ORIGINS=http://localhost:3000
