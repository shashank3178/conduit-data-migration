# Snowbridge local development only. Never place real secrets in this file.
SNOWBRIDGE_ENV=development
SNOWBRIDGE_METADATA_DATABASE_URL=postgresql://snowbridge:snowbridge@localhost:5432/snowbridge_metadata
SNOWBRIDGE_SECRET_PROVIDER=local
SNOWBRIDGE_LOG_LEVEL=INFO
SNOWBRIDGE_CONNECT_TIMEOUT_SECONDS=10
SNOWBRIDGE_STATEMENT_TIMEOUT_MS=0
